{% if block.settings.show_offer %}
  <div
    class="bs-offer-details"
    style="
      --bs-offer-bg: {{ block.settings.background_color }};
      --bs-offer-border: {{ block.settings.border_color }};
      --bs-offer-accent: {{ block.settings.accent_color }};
    "
    {{ block.shopify_attributes }}
  >
    {% if block.settings.heading != blank %}
      <strong>{{ block.settings.heading }}</strong>
    {% endif %}
    <ul>
      {% if block.settings.offer_1 != blank %}<li>{{ block.settings.offer_1 }}</li>{% endif %}
      {% if block.settings.offer_2 != blank %}<li>{{ block.settings.offer_2 }}</li>{% endif %}
      {% if block.settings.offer_3 != blank %}<li>{{ block.settings.offer_3 }}</li>{% endif %}
    </ul>
  </div>
{% endif %}

{% stylesheet %}
  .bs-offer-details {
    padding: 14px 16px;
    border: 1px solid var(--bs-offer-border, #ffd6d6);
    border-radius: 8px;
    background: var(--bs-offer-bg, #fff7f3);
  }

  .bs-offer-details strong {
    display: block;
    margin-bottom: 8px;
    color: #0d1c2f;
    font-size: 0.88rem;
  }

  .bs-offer-details ul {
    display: grid;
    gap: 5px;
    margin: 0;
    padding-left: 18px;
    color: #45464d;
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .bs-offer-details li::marker {
    color: var(--bs-offer-accent, #b6191a);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Offer details",
  "settings": [
    { "type": "checkbox", "id": "show_offer", "label": "Show offer details", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Available offers" },
    { "type": "text", "id": "offer_1", "label": "Offer 1", "default": "Free shipping on prepaid orders above ₹499." },
    { "type": "text", "id": "offer_2", "label": "Offer 2", "default": "Extra 5% off on selected publisher bundles." },
    { "type": "text", "id": "offer_3", "label": "Offer 3" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#fff7f3" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#ffd6d6" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#b6191a" }
  ],
  "presets": [
    { "name": "Offer details" }
  ]
}
{% endschema %}
