

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'collection-wrapper-styles' %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<results-list
  class="section product-grid-container spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div
    class="collection-wrapper grid gap-style"
  >
    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate search.results by products_per_page %}
      {% if search.results_count > 0 %}
        {% content_for 'block', type: 'filters', id: 'filters', results: search, results_size: search.results_count %}
        {% assign products = search.results | where: 'object_type', 'product' %}
      {% else %}
        {% assign collection = settings.empty_state_collection | default: collections.all %}
        {% assign default_title = 'content.search_results_resource_products' | t %}
        {% assign title = settings.empty_state_collection.title | default: default_title %}
        {% assign products = collection.products %}
      {% endif %}

      {% capture children %}
        {% assign search_query_downcase = search.terms | default: '' | downcase | strip %}
        {% if search_query_downcase == '*' %}
          {% assign search_query_downcase = '' %}
        {% endif %}
        {% assign rendered_product_ids = ',' %}

        {% for product in products %}
          {% assign product_title_downcase = product.title | downcase | strip %}
          {% assign product_author_downcase = product.metafields.custom.author.value | default: product.metafields.custom.author | downcase | strip %}
          {% assign product_publisher_downcase = product.metafields.custom.publisher_name.value | default: product.vendor | downcase | strip %}
          {% assign product_isbn_downcase = product.metafields.custom.isbn.value | default: product.selected_or_first_available_variant.barcode | downcase | strip %}
          {% assign product_format = product.metafields.custom.format.value | default: product.metafields.custom.format | default: product.metafields.custom.cover_type.value | default: product.metafields.custom.cover_type %}
          {% assign product_language = product.metafields.custom.language.value | default: product.metafields.custom.language %}
          {% capture product_collection_handles %}
            {% for product_collection in product.collections %}
              {{ product_collection.handle }}|
            {% endfor %}
          {% endcapture %}
          {% assign product_id_token = product.id | append: ',' | prepend: ',' %}
          {% assign is_exact_keyword_match = false %}
          {% if search_query_downcase != blank %}
            {% if product_title_downcase == search_query_downcase
              or product_author_downcase == search_query_downcase
              or product_publisher_downcase == search_query_downcase
              or product_isbn_downcase == search_query_downcase
            %}
              {% assign is_exact_keyword_match = true %}
            {% endif %}
          {% endif %}
          {% if is_exact_keyword_match %}
            {% assign rendered_product_ids = rendered_product_ids | append: product.id | append: ',' %}
            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--{{ forloop.index0 }}"
              data-page="{{ paginate.current_page }}"
              data-product-id="{{ product.id }}"
              data-bookstore-product-price-min="{{ product.price_min }}"
              data-bookstore-product-price-max="{{ product.price_max }}"
              data-bookstore-product-vendor="{{ product.vendor | escape }}"
              data-bookstore-product-author="{{ product.metafields.custom.author.value | default: product.metafields.custom.author | escape }}"
              data-bookstore-product-format="{{ product_format | escape }}"
              data-bookstore-product-language="{{ product_language | escape }}"
              data-bookstore-product-available="{% if product.available %}1{% else %}0{% endif %}"
              data-bookstore-product-collections="{{ product_collection_handles | strip | escape }}"
              ref="cards[]"
            >
              {% content_for 'block',
                type: '_product-card',
                id: 'product-card',
                closest.product: product,
                product_view_context: 'search'
              %}
            </li>
          {% endif %}
        {% endfor %}

        {% for product in products %}
          {% assign product_title_downcase = product.title | downcase | strip %}
          {% assign product_author_downcase = product.metafields.custom.author.value | default: product.metafields.custom.author | downcase | strip %}
          {% assign product_publisher_downcase = product.metafields.custom.publisher_name.value | default: product.vendor | downcase | strip %}
          {% assign product_isbn_downcase = product.metafields.custom.isbn.value | default: product.selected_or_first_available_variant.barcode | downcase | strip %}
          {% assign product_format = product.metafields.custom.format.value | default: product.metafields.custom.format | default: product.metafields.custom.cover_type.value | default: product.metafields.custom.cover_type %}
          {% assign product_language = product.metafields.custom.language.value | default: product.metafields.custom.language %}
          {% capture product_collection_handles %}
            {% for product_collection in product.collections %}
              {{ product_collection.handle }}|
            {% endfor %}
          {% endcapture %}
          {% assign product_id_token = product.id | append: ',' | prepend: ',' %}
          {% assign is_secondary_keyword_match = false %}
          {% if search_query_downcase != blank %}
            {% if product_title_downcase contains search_query_downcase
              or product_author_downcase contains search_query_downcase
              or product_publisher_downcase contains search_query_downcase
              or product_isbn_downcase contains search_query_downcase
            %}
              {% assign is_secondary_keyword_match = true %}
            {% endif %}
          {% endif %}
          {% if is_secondary_keyword_match %}
            {% unless rendered_product_ids contains product_id_token %}
              {% assign rendered_product_ids = rendered_product_ids | append: product.id | append: ',' %}
              <li
                id="{{ section.id }}-{{ product.id }}"
                class="product-grid__item product-grid__item--{{ forloop.index0 }}"
                data-page="{{ paginate.current_page }}"
                data-product-id="{{ product.id }}"
                data-bookstore-product-price-min="{{ product.price_min }}"
                data-bookstore-product-price-max="{{ product.price_max }}"
                data-bookstore-product-vendor="{{ product.vendor | escape }}"
                data-bookstore-product-author="{{ product.metafields.custom.author.value | default: product.metafields.custom.author | escape }}"
                data-bookstore-product-format="{{ product_format | escape }}"
                data-bookstore-product-language="{{ product_language | escape }}"
                data-bookstore-product-available="{% if product.available %}1{% else %}0{% endif %}"
                data-bookstore-product-collections="{{ product_collection_handles | strip | escape }}"
                ref="cards[]"
              >
                {% content_for 'block',
                  type: '_product-card',
                  id: 'product-card',
                  closest.product: product,
                  product_view_context: 'search'
                %}
              </li>
            {% endunless %}
          {% endif %}
        {% endfor %}

        {% for product in products %}
          {% assign product_id_token = product.id | append: ',' | prepend: ',' %}
          {% unless rendered_product_ids contains product_id_token %}
          {% assign product_format = product.metafields.custom.format.value | default: product.metafields.custom.format | default: product.metafields.custom.cover_type.value | default: product.metafields.custom.cover_type %}
          {% assign product_language = product.metafields.custom.language.value | default: product.metafields.custom.language %}
          {% capture product_collection_handles %}
            {% for product_collection in product.collections %}
              {{ product_collection.handle }}|
            {% endfor %}
          {% endcapture %}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item product-grid__item--{{ forloop.index0 }}"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            data-bookstore-product-price-min="{{ product.price_min }}"
            data-bookstore-product-price-max="{{ product.price_max }}"
            data-bookstore-product-vendor="{{ product.vendor | escape }}"
            data-bookstore-product-author="{{ product.metafields.custom.author.value | default: product.metafields.custom.author | escape }}"
            data-bookstore-product-format="{{ product_format | escape }}"
            data-bookstore-product-language="{{ product_language | escape }}"
            data-bookstore-product-available="{% if product.available %}1{% else %}0{% endif %}"
            data-bookstore-product-collections="{{ product_collection_handles | strip | escape }}"
            ref="cards[]"
          >
            {% content_for 'block',
              type: '_product-card',
              id: 'product-card',
              closest.product: product,
              product_view_context: 'search'
            %}
          </li>
          {% endunless %}
        {% endfor %}
      {% endcapture %}

      {% render 'product-grid',
        section: section,
        children: children,
        products: products,
        paginate: paginate,
        enable_infinite_scroll: section.settings.enable_infinite_scroll,
        title: title
      %}
    {% endpaginate %}
  </div>
</results-list>

{% schema %}
{
  "name": "t:names.search_results",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.edit_empty_state_collection_in_theme_settings"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
