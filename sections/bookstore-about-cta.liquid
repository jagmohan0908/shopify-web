<section class="bb-about-cta color-{{ section.settings.color_scheme }}" style="--bb-about-bg: {{ section.settings.background_color }}; --bb-about-accent: {{ section.settings.accent_color }}; --bb-about-max: {{ section.settings.max_width }}px; --bb-about-side: {{ section.settings.side_padding }}px; --bb-about-top: {{ section.settings.padding_top }}px; --bb-about-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="bb-about-inner">
    <div class="bb-about-cta__card">
      <div>
        <p class="bb-about-kicker">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
      </div>
      <div class="bb-about-cta__actions">
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="bb-about-button">{{ section.settings.button_label }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a href="{{ section.settings.secondary_link }}" class="bb-about-link">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .bb-about-cta {
    background: var(--bb-about-bg);
    padding: var(--bb-about-top) 0 var(--bb-about-bottom);
  }

  .bb-about-inner {
    margin: 0 auto;
    max-width: var(--bb-about-max);
    padding-left: var(--bb-about-side);
    padding-right: var(--bb-about-side);
    width: 100%;
  }

  .bb-about-kicker {
    color: var(--bb-about-accent);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .14em;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .bb-about-cta__card {
    align-items: center;
    background: #10213a;
    color: #fff;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    padding: clamp(26px, 4vw, 48px);
  }

  .bb-about-cta__card .bb-about-kicker {
    color: #ffb3b3;
  }

  .bb-about-cta__card h2 {
    color: #fff;
    font-family: var(--font-heading--family, serif);
    font-size: clamp(28px, 4vw, 46px);
    line-height: 1.05;
    margin: 0 0 12px;
  }

  .bb-about-cta__card p:not(.bb-about-kicker) {
    color: rgba(255,255,255,.78);
    font-size: 15px;
    line-height: 1.7;
    margin: 0;
    max-width: 680px;
  }

  .bb-about-cta__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .bb-about-button,
  .bb-about-link {
    align-items: center;
    display: inline-flex;
    font-weight: 900;
    min-height: 48px;
    padding: 0 22px;
    text-decoration: none;
  }

  .bb-about-button {
    background: var(--bb-about-accent);
    color: #fff;
  }

  .bb-about-link {
    border: 1px solid rgba(255,255,255,.28);
    color: #fff;
  }

  @media (max-width: 749px) {
    .bb-about-inner {
      padding-left: min(var(--bb-about-side), 20px);
      padding-right: min(var(--bb-about-side), 20px);
    }

    .bb-about-cta__card {
      grid-template-columns: 1fr;
    }

    .bb-about-cta__actions {
      justify-content: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About CTA",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f2f6ff" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#b6191a" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Need help?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to Books Bunny" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "For publisher onboarding, bulk orders, institutional requirements, or customer support, contact our team." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Contact us" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "/pages/contact" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "Email sales" },
    { "type": "text", "id": "secondary_link", "label": "Secondary link", "default": "mailto:sales@unboundscript.com" },
    { "type": "range", "id": "max_width", "label": "Content max width", "min": 900, "max": 1600, "step": 20, "unit": "px", "default": 1240 },
    { "type": "range", "id": "side_padding", "label": "Left/right padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "About CTA" }]
}
{% endschema %}
