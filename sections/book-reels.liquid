{% liquid
  assign reel_collection = section.settings.collection | default: collections.all
%}

<div
  class="sb-home sb-theme--{{ section.settings.color_theme }}"
  style="
    --sb-section-bg: {{ section.settings.background_color }};
    --sb-section-heading: {{ section.settings.heading_color }};
    --sb-section-text: {{ section.settings.text_color }};
    --sb-section-accent: {{ section.settings.accent_color }};
    --sb-section-card-bg: {{ section.settings.card_background }};
  "
>
  <section class="sb-section sb-reels sb-container" aria-label="{{ section.settings.heading | escape }}">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    <div class="sb-reel-strip">
      {% for product in reel_collection.products limit: section.settings.product_limit offset: section.settings.product_offset %}
        {% liquid
          assign reel_video = blank
          for media in product.media
            if media.media_type == 'video' or media.media_type == 'external_video'
              assign reel_video = media
              break
            endif
          endfor
        %}
        <article class="sb-reel">
          <span class="sb-reel__media">
            {% if reel_video != blank %}
              {{ reel_video | media_tag: image_size: '520x', autoplay: false, loop: false, controls: true, preload: 'metadata' }}
            {% elsif product.featured_image %}
              {{ product.featured_image | image_url: width: 520 | image_tag: loading: 'lazy', alt: product.title }}
            {% endif %}
            {% if section.settings.show_play_icon and reel_video == blank %}<i aria-hidden="true">play</i>{% endif %}
          </span>
          <a href="{{ product.url }}"><strong>{{ product.title }}</strong></a>
          <small>{{ product.vendor }}</small>
        </article>
      {% else %}
        <p class="sb-empty">Choose a collection to show reels.</p>
      {% endfor %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Book reels",
  "tag": "section",
  "class": "section-book-reels",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Book Reels" },
    { "type": "text", "id": "text", "label": "Text", "default": "Watch short previews of our latest books." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Number of reels", "min": 3, "max": 8, "step": 1, "default": 5 },
    { "type": "range", "id": "product_offset", "label": "Skip products", "min": 0, "max": 30, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "show_play_icon", "label": "Show play icon overlay", "default": true },
    {
      "type": "select",
      "id": "color_theme",
      "label": "Color theme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "soft-blue", "label": "Soft blue" },
        { "value": "crimson", "label": "Crimson" },
        { "value": "navy", "label": "Navy" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "custom"
    },
    { "type": "color", "id": "background_color", "label": "Custom background", "default": "#f8f9ff" },
    { "type": "color", "id": "heading_color", "label": "Custom heading color", "default": "#0d1c2f" },
    { "type": "color", "id": "text_color", "label": "Custom text color", "default": "#45464d" },
    { "type": "color", "id": "accent_color", "label": "Custom accent color", "default": "#b6191a" },
    { "type": "color", "id": "card_background", "label": "Custom card background", "default": "#ffffff" }
  ],
  "presets": [
    { "name": "Book reels" }
  ]
}
{% endschema %}
