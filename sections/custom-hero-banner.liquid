{% liquid
  assign hero_collection = section.settings.collection | default: collections.all
  assign all_books_url = routes.collections_url | append: '/all'
%}

<div
  class="sb-home sb-custom-hero sb-theme--{{ section.settings.color_theme }}"
  style="
    --sb-hero-bg: {{ section.settings.background_color }};
    --sb-hero-panel: {{ section.settings.panel_color }};
    --sb-hero-text: {{ section.settings.text_color }};
    --sb-hero-muted: {{ section.settings.muted_text_color }};
    --sb-hero-height: {{ section.settings.desktop_height }}px;
    --sb-banner-overlay: {{ section.settings.banner_overlay | divided_by: 100.0 }};
  "
>
  <section class="sb-hero sb-container sb-hero--{{ section.settings.text_alignment }}" aria-label="{{ section.settings.heading | escape }}">
    <div class="sb-hero__search">
      {% if section.settings.heading != blank %}
        <h1>{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.copy != blank %}
        <p>{{ section.settings.copy }}</p>
      {% endif %}

      {% if section.settings.show_search %}
        <form class="sb-search" action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="type" value="product">
          <span aria-hidden="true">search</span>
          <input
            name="q"
            type="search"
            placeholder="{{ section.settings.search_placeholder | escape }}"
            aria-label="{{ section.settings.search_placeholder | escape }}"
          >
        </form>
      {% endif %}
    </div>

    <div class="sb-hero__banners">
      {% for block in section.blocks %}
        {% liquid
          assign linked_product = block.settings.product
          assign banner_link = block.settings.link
          assign banner_image = block.settings.image
          assign banner_label = block.settings.label

          if banner_link == blank and linked_product != blank
            assign banner_link = linked_product.url
          endif
          if banner_link == blank
            assign banner_link = all_books_url
          endif
          if banner_image == blank and linked_product != blank
            assign banner_image = linked_product.featured_image
          endif
          if banner_image == blank
            assign fallback_offset = forloop.index0
            for fallback_product in hero_collection.products limit: 1 offset: fallback_offset
              assign banner_image = fallback_product.featured_image
              if linked_product == blank and block.settings.link == blank
                assign banner_link = fallback_product.url
              endif
            endfor
          endif
        %}

        <a class="sb-mini-banner" href="{{ banner_link }}" {{ block.shopify_attributes }}>
          {% if banner_image != blank %}
            {{ banner_image | image_url: width: 900 | image_tag: loading: 'eager', widths: '360, 540, 720, 900', sizes: '(max-width: 760px) calc(100vw - 32px), 32vw', alt: banner_label }}
          {% endif %}
          {% if banner_label != blank %}
            <span>{{ banner_label }}</span>
          {% endif %}
        </a>
      {% else %}
        <a class="sb-mini-banner sb-mini-banner--fallback" href="{{ all_books_url }}">
          <span>Add hero banner blocks</span>
        </a>
      {% endfor %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Custom hero banner",
  "tag": "section",
  "class": "section-custom-hero-banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Next Great Adventure Awaits"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Text",
      "default": "Explore the world's largest collection of curated literature."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search 10,000+ titles..."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback banner product collection"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop hero height",
      "min": 360,
      "max": 680,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "select",
      "id": "color_theme",
      "label": "Color theme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "soft-blue", "label": "Soft blue" },
        { "value": "crimson", "label": "Crimson" },
        { "value": "navy", "label": "Navy" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "custom"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Custom section background",
      "default": "#f8f9ff"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Custom main banner background",
      "default": "#eff4ff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Custom heading color",
      "default": "#0d1c2f"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Custom text color",
      "default": "#45464d"
    },
    {
      "type": "range",
      "id": "banner_overlay",
      "label": "Small banner overlay",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Small banner",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Rare & Antiquarian"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Use product image/link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Custom hero banner",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "label": "Rare & Antiquarian"
          }
        },
        {
          "type": "banner",
          "settings": {
            "label": "Award Winners"
          }
        },
        {
          "type": "banner",
          "settings": {
            "label": "Curated Picks"
          }
        }
      ]
    }
  ]
}
{% endschema %}
