<section class="bb-about-hero color-{{ section.settings.color_scheme }}" style="--bb-about-bg: {{ section.settings.background_color }}; --bb-about-accent: {{ section.settings.accent_color }}; --bb-about-max: {{ section.settings.max_width }}px; --bb-about-side: {{ section.settings.side_padding }}px; --bb-about-top: {{ section.settings.padding_top }}px; --bb-about-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="bb-about-inner">
    <div class="bb-about-hero__grid">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="bb-about-kicker">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1>{{ section.settings.heading | default: page.title }}</h1>
      </div>
      {% if section.settings.intro != blank %}
        <p>{{ section.settings.intro }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .bb-about-hero {
    background: var(--bb-about-bg);
    padding: var(--bb-about-top) 0 var(--bb-about-bottom);
  }

  .bb-about-inner {
    margin: 0 auto;
    max-width: var(--bb-about-max);
    padding-left: var(--bb-about-side);
    padding-right: var(--bb-about-side);
    width: 100%;
  }

  .bb-about-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(18px, 4vw, 44px);
    align-items: end;
  }

  .bb-about-kicker {
    color: var(--bb-about-accent);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .14em;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .bb-about-hero h1 {
    color: #10213a;
    font-family: var(--font-heading--family, serif);
    font-size: clamp(38px, 6vw, 70px);
    letter-spacing: -.04em;
    line-height: .98;
    margin: 0;
  }

  .bb-about-hero p:not(.bb-about-kicker) {
    color: rgba(16, 33, 58, .74);
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 749px) {
    .bb-about-inner {
      padding-left: min(var(--bb-about-side), 20px);
      padding-right: min(var(--bb-about-side), 20px);
    }

    .bb-about-hero__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About hero",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f2f6ff" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#b6191a" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A modern marketplace for books from trusted publishers" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Built for students, professionals, parents, schools, colleges, libraries, and book lovers." },
    { "type": "range", "id": "max_width", "label": "Content max width", "min": 900, "max": 1600, "step": 20, "unit": "px", "default": 1240 },
    { "type": "range", "id": "side_padding", "label": "Left/right padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 32 }
  ],
  "presets": [{ "name": "About hero" }]
}
{% endschema %}
