{% liquid
  assign all_books_url = routes.collections_url | append: '/all'
  assign view_url = section.settings.link | default: all_books_url
%}

<div
  class="sb-home sb-theme--{{ section.settings.color_theme }}"
  style="
    --sb-section-bg: {{ section.settings.background_color }};
    --sb-section-heading: {{ section.settings.heading_color }};
    --sb-section-text: {{ section.settings.text_color }};
    --sb-section-accent: {{ section.settings.accent_color }};
    --sb-section-card-bg: {{ section.settings.card_background }};
  "
>
  <section class="sb-section sb-bestsellers sb-container">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    <div class="sb-bestseller-grid">
      {% for block in section.blocks %}
        {% liquid
          assign list_collection = block.settings.collection | default: section.settings.collection | default: collections.all
          assign list_heading_url = list_collection.url | default: routes.collections_url
          assign bestseller_count = 0
        %}
        <article class="sb-bestseller-list" {{ block.shopify_attributes }}>
          <h3>
            <a href="{{ list_heading_url }}">{{ block.settings.heading }}</a>
          </h3>

          {% for product in list_collection.products %}
            {% liquid
              assign should_show_product = false
              if section.settings.bestseller_tag == blank
                assign should_show_product = true
              elsif product.tags contains section.settings.bestseller_tag
                assign should_show_product = true
              endif
            %}
            {% if should_show_product and bestseller_count < section.settings.products_per_list %}
              {% assign bestseller_count = bestseller_count | plus: 1 %}
              <a href="{{ product.url }}">
                <span>{{ bestseller_count }}</span>
                <span class="sb-bestseller-list__cover">
                  {% if product.featured_image %}
                    {{ product.featured_image | image_url: width: 140 | image_tag: loading: 'lazy', alt: product.title }}
                  {% else %}
                    {% render 'bookstore-sample-cover', title: product.title, product: product %}
                  {% endif %}
                </span>
                <strong title="{{ product.title | escape }}">{{ product.title }}</strong>
              </a>
            {% endif %}
          {% endfor %}

          {% if bestseller_count == 0 %}
            {% for product in list_collection.products limit: section.settings.products_per_list %}
              {% assign bestseller_count = bestseller_count | plus: 1 %}
              <a href="{{ product.url }}">
                <span>{{ bestseller_count }}</span>
                <span class="sb-bestseller-list__cover">
                  {% if product.featured_image %}
                    {{ product.featured_image | image_url: width: 140 | image_tag: loading: 'lazy', alt: product.title }}
                  {% else %}
                    {% render 'bookstore-sample-cover', title: product.title, product: product %}
                  {% endif %}
                </span>
                <strong title="{{ product.title | escape }}">{{ product.title }}</strong>
              </a>
            {% else %}
              <p class="sb-bestseller-empty">Choose a collection with products to show this list.</p>
            {% endfor %}
          {% endif %}
        </article>
      {% else %}
        <p class="sb-empty">Add bestseller list blocks.</p>
      {% endfor %}
    </div>
    {% if section.settings.link_label != blank %}<a class="sb-watch-link" href="{{ view_url }}">{{ section.settings.link_label }}</a>{% endif %}
  </section>
</div>

{% schema %}
{
  "name": "Bestseller lists",
  "tag": "section",
  "class": "section-bestseller-lists",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Current Bestseller Lists" },
    { "type": "collection", "id": "collection", "label": "Fallback collection" },
    { "type": "text", "id": "bestseller_tag", "label": "Required product tag", "default": "bestseller" },
    { "type": "range", "id": "products_per_list", "label": "Products per list", "min": 3, "max": 8, "step": 1, "default": 5 },
    { "type": "text", "id": "link_label", "label": "Bottom link label", "default": "Watch short previews of our latest books." },
    { "type": "url", "id": "link", "label": "Bottom link" },
    {
      "type": "select",
      "id": "color_theme",
      "label": "Color theme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "soft-blue", "label": "Soft blue" },
        { "value": "crimson", "label": "Crimson" },
        { "value": "navy", "label": "Navy" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "custom"
    },
    { "type": "color", "id": "background_color", "label": "Custom background", "default": "#f8f9ff" },
    { "type": "color", "id": "heading_color", "label": "Custom heading color", "default": "#0d1c2f" },
    { "type": "color", "id": "text_color", "label": "Custom text color", "default": "#45464d" },
    { "type": "color", "id": "accent_color", "label": "Custom accent color", "default": "#b6191a" },
    { "type": "color", "id": "card_background", "label": "Custom card background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "list",
      "name": "List",
      "settings": [
        { "type": "text", "id": "heading", "label": "List heading", "default": "Fiction" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Bestseller lists",
      "blocks": [
        { "type": "list", "settings": { "heading": "Fiction" } },
        { "type": "list", "settings": { "heading": "Non Fiction" } },
        { "type": "list", "settings": { "heading": "Self Improvement" } },
        { "type": "list", "settings": { "heading": "Business" } }
      ]
    }
  ]
}
{% endschema %}
