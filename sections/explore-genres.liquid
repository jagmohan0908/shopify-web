<div
  class="sb-home sb-theme--{{ section.settings.color_theme }}"
  style="
    --sb-section-bg: {{ section.settings.background_color }};
    --sb-section-heading: {{ section.settings.heading_color }};
    --sb-section-text: {{ section.settings.text_color }};
    --sb-section-accent: {{ section.settings.accent_color }};
    --sb-section-card-bg: {{ section.settings.card_background }};
    --sb-genre-tile-bg: {{ section.settings.tile_background }};
    --sb-genre-image-fit: {{ section.settings.image_fit }};
  "
>
  <section class="sb-section sb-genres sb-container" aria-label="{{ section.settings.heading | escape }}">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    <div class="sb-genre-grid">
      {% for block in section.blocks %}
        {% liquid
          assign genre_handle = block.settings.label | handleize
          assign default_genre_url = routes.collections_url | append: '/' | append: genre_handle
        %}
        <a href="{{ block.settings.link | default: default_genre_url }}" {{ block.shopify_attributes }}>
          <span class="sb-genre-icon{% if block.settings.image != blank %} sb-genre-icon--image{% endif %}" data-icon="{{ block.settings.icon }}">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '120, 180, 260, 360', sizes: '(max-width: 720px) 45vw, 180px', alt: block.settings.label }}
            {% else %}
              <span class="sb-genre-fallback sb-genre-fallback--{{ forloop.index | modulo: 6 }}">
                <span aria-hidden="true"></span>
              </span>
            {% endif %}
          </span>
          <strong>{{ block.settings.label }}</strong>
        </a>
      {% else %}
        <p class="sb-empty">Add genre blocks in the theme editor.</p>
      {% endfor %}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Explore genres",
  "tag": "section",
  "class": "section-explore-genres",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore Genres" },
    {
      "type": "select",
      "id": "color_theme",
      "label": "Color theme",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "soft-blue", "label": "Soft blue" },
        { "value": "crimson", "label": "Crimson" },
        { "value": "navy", "label": "Navy" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "custom"
    },
    { "type": "color", "id": "background_color", "label": "Custom background", "default": "#f8f9ff" },
    { "type": "color", "id": "heading_color", "label": "Custom heading color", "default": "#0d1c2f" },
    { "type": "color", "id": "text_color", "label": "Custom text color", "default": "#45464d" },
    { "type": "color", "id": "accent_color", "label": "Custom accent color", "default": "#b6191a" },
    { "type": "color", "id": "card_background", "label": "Custom card background", "default": "#ffffff" },
    { "type": "color", "id": "tile_background", "label": "Tile background", "default": "#eff4ff" },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" }
      ],
      "default": "contain"
    }
  ],
  "blocks": [
    {
      "type": "genre",
      "name": "Genre",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Mystery" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon style",
          "options": [
            { "value": "search", "label": "Search" },
            { "value": "history", "label": "History" },
            { "value": "child", "label": "Children" },
            { "value": "person", "label": "Author" },
            { "value": "science", "label": "Science" },
            { "value": "layers", "label": "Layers" },
            { "value": "triangle", "label": "Poetry" },
            { "value": "book", "label": "Book" }
          ],
          "default": "search"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Explore genres",
      "blocks": [
        { "type": "genre", "settings": { "label": "Mystery", "icon": "search" } },
        { "type": "genre", "settings": { "label": "History", "icon": "history" } },
        { "type": "genre", "settings": { "label": "Science", "icon": "science" } },
        { "type": "genre", "settings": { "label": "Biography", "icon": "person" } },
        { "type": "genre", "settings": { "label": "Art", "icon": "layers" } },
        { "type": "genre", "settings": { "label": "Poetry", "icon": "triangle" } },
        { "type": "genre", "settings": { "label": "Fiction", "icon": "book" } }
      ]
    }
  ]
}
{% endschema %}
