{% liquid
  assign source_collection = section.settings.collection | default: product.collections.first | default: collections.all
  assign shown_count = 0
%}

<section class="sb-product-section sb-product-container">
  <div class="sb-product-section__head">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </div>
  </div>

  <div class="sb-product-book-row">
    {% for related_product in source_collection.products %}
      {% if related_product.id != product.id and shown_count < section.settings.product_limit %}
        {% assign shown_count = shown_count | plus: 1 %}
        {% render 'stitch-book-card', product: related_product, section_id: section.id, compact: true %}
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Readers also enjoyed",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Readers Also Enjoyed" },
    { "type": "text", "id": "text", "label": "Text", "default": "Recommended based on your current view." },
    { "type": "collection", "id": "collection", "label": "Products collection" },
    { "type": "range", "id": "product_limit", "label": "Products", "min": 4, "max": 10, "step": 1, "default": 5 }
  ],
  "presets": [
    { "name": "Readers also enjoyed" }
  ]
}
{% endschema %}
