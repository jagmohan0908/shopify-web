{% liquid
  assign eyebrow = section.settings.eyebrow | default: 'Contact us'
  assign heading = section.settings.heading | default: page.title
  assign intro = section.settings.intro
  assign address = section.settings.address
  assign phone = section.settings.phone
  assign email = section.settings.email
  assign manuscript_text = section.settings.manuscript_text
  assign manuscript_link = section.settings.manuscript_link
  assign map_embed_url = section.settings.map_embed_url
  if map_embed_url == blank
    assign map_embed_url = 'https://www.google.com/maps?q=2%2F41%20Ansari%20Road%2C%20Daryaganj%2C%20Delhi%20110002&output=embed'
  endif
%}

<section class="bb-contact-page color-{{ section.settings.color_scheme }}" style="--bb-contact-accent: {{ section.settings.accent_color }}; --bb-contact-card: {{ section.settings.card_color }}; --bb-contact-soft: {{ section.settings.soft_color }};">
  <div class="bb-contact-page__inner page-width">
    <div class="bb-contact-hero">
      <div>
        {% if eyebrow != blank %}
          <p class="bb-contact-hero__eyebrow">{{ eyebrow }}</p>
        {% endif %}
        <h1 class="bb-contact-hero__heading">{{ heading }}</h1>
      </div>
      {% if intro != blank %}
        <p class="bb-contact-hero__intro">{{ intro }}</p>
      {% endif %}
    </div>

    <div class="bb-contact-grid">
      <div class="bb-contact-info">
        <div class="bb-contact-card bb-contact-card--address">
          <span class="bb-contact-card__label">{{ section.settings.address_label }}</span>
          <h2>{{ section.settings.address_heading }}</h2>
          {% if address != blank %}
            <div class="bb-contact-card__text">{{ address | newline_to_br }}</div>
          {% endif %}
        </div>

        <div class="bb-contact-mini-grid">
          <div class="bb-contact-card">
            <span class="bb-contact-card__label">{{ section.settings.phone_label }}</span>
            <h2>{{ section.settings.phone_heading }}</h2>
            {% if phone != blank %}
              <a class="bb-contact-card__link" href="tel:{{ phone | remove: ' ' | remove: '-' }}">{{ phone }}</a>
            {% endif %}
          </div>

          <div class="bb-contact-card">
            <span class="bb-contact-card__label">{{ section.settings.email_label }}</span>
            <h2>{{ section.settings.email_heading }}</h2>
            {% if email != blank %}
              <a class="bb-contact-card__link" href="mailto:{{ email }}">{{ email }}</a>
            {% endif %}
          </div>
        </div>

        {% if manuscript_text != blank %}
          <a class="bb-contact-manuscript" href="{{ manuscript_link | default: '#' }}">
            <span>{{ manuscript_text }}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M5 12h12.2m-4.7-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}
      </div>

      <div class="bb-contact-form-panel">
        <p class="bb-contact-card__label">{{ section.settings.form_kicker }}</p>
        <h2>{{ section.settings.form_heading }}</h2>
        {% form 'contact', class: 'bb-contact-form' %}
          {% if form.posted_successfully? %}
            <div class="bb-contact-form__success" tabindex="-1" autofocus>
              {{ section.settings.success_message }}
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="bb-contact-form__error" tabindex="-1" autofocus>
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="bb-contact-form__row">
            <label for="ContactForm-name-{{ section.id }}">{{ section.settings.name_label }}</label>
            <input id="ContactForm-name-{{ section.id }}" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name" placeholder="{{ section.settings.name_label }}" required>
          </div>

          <div class="bb-contact-form__row">
            <label for="ContactForm-email-{{ section.id }}">{{ section.settings.email_field_label }}</label>
            <input id="ContactForm-email-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" placeholder="{{ section.settings.email_field_label }}" required>
          </div>

          <div class="bb-contact-form__row">
            <label for="ContactForm-phone-{{ section.id }}">{{ section.settings.phone_field_label }}</label>
            <input id="ContactForm-phone-{{ section.id }}" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel" placeholder="{{ section.settings.phone_field_label }}">
          </div>

          <div class="bb-contact-form__row">
            <label for="ContactForm-message-{{ section.id }}">{{ section.settings.message_label }}</label>
            <textarea id="ContactForm-message-{{ section.id }}" name="contact[body]" rows="4" placeholder="{{ section.settings.message_label }}">{{ form.body }}</textarea>
          </div>

          <button type="submit" class="bb-contact-form__submit">
            {{ section.settings.button_label }}
          </button>
        {% endform %}
      </div>
    </div>

    <div class="bb-contact-map-card">
      <div class="bb-contact-map-card__copy">
        <p class="bb-contact-card__label">{{ section.settings.map_kicker }}</p>
        <h2>{{ section.settings.map_heading }}</h2>
        {% if section.settings.map_text != blank %}
          <p>{{ section.settings.map_text }}</p>
        {% endif %}
      </div>
      <div class="bb-contact-map">
        <iframe
          src="{{ map_embed_url | escape }}"
          title="{{ section.settings.map_heading | escape }}"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen>
        </iframe>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .bb-contact-page {
    background:
      radial-gradient(circle at 10% 8%, color-mix(in srgb, var(--bb-contact-accent) 12%, transparent), transparent 28rem),
      linear-gradient(180deg, var(--bb-contact-soft), rgba(255,255,255,0) 44rem);
    padding: clamp(36px, 6vw, 78px) 0 clamp(48px, 7vw, 92px);
  }

  .bb-contact-page__inner {
    display: grid;
    gap: clamp(24px, 4vw, 42px);
  }

  .bb-contact-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 460px);
    gap: 24px;
    align-items: end;
  }

  .bb-contact-hero__eyebrow,
  .bb-contact-card__label {
    color: var(--bb-contact-accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .14em;
    line-height: 1.2;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .bb-contact-hero__heading {
    color: #10213a;
    font-family: var(--font-heading--family, serif);
    font-size: clamp(36px, 6vw, 68px);
    line-height: .98;
    letter-spacing: -.04em;
    margin: 0;
    max-width: 820px;
  }

  .bb-contact-hero__intro {
    color: rgba(16, 33, 58, .74);
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.7;
    margin: 0;
  }

  .bb-contact-grid {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(360px, .78fr);
    gap: clamp(18px, 3vw, 30px);
    align-items: start;
  }

  .bb-contact-info {
    display: grid;
    align-content: start;
    align-self: start;
    row-gap: 4px;
  }

  .bb-contact-mini-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-self: start;
    column-gap: 18px;
    row-gap: 4px;
  }

  .bb-contact-card,
  .bb-contact-form-panel,
  .bb-contact-map-card {
    background: var(--bb-contact-card);
    border: 1px solid rgba(16, 33, 58, .11);
    border-radius: 0;
    box-shadow: 0 18px 42px rgba(16, 33, 58, .08);
  }

  .bb-contact-card {
    box-sizing: border-box;
    height: 140px;
    min-height: 140px;
    overflow: hidden;
    padding: 20px;
  }

  .bb-contact-card--address {
    height: 140px;
    min-height: 140px;
    display: block;
  }

  .bb-contact-card h2,
  .bb-contact-form-panel h2,
  .bb-contact-map-card h2 {
    color: #10213a;
    font-family: var(--font-heading--family, serif);
    font-size: clamp(22px, 2.5vw, 32px);
    line-height: 1.08;
    margin: 0 0 16px;
  }

  .bb-contact-card__text,
  .bb-contact-card__link,
  .bb-contact-map-card p {
    color: rgba(16, 33, 58, .76);
    font-size: 15px;
    line-height: 1.7;
  }

  .bb-contact-card__link {
    text-decoration: none;
    word-break: break-word;
  }

  .bb-contact-card__link:hover {
    color: var(--bb-contact-accent);
  }

  .bb-contact-manuscript {
    align-items: center;
    background: #10213a;
    color: #fff;
    display: flex;
    font-size: 14px;
    font-weight: 800;
    gap: 12px;
    justify-content: space-between;
    letter-spacing: .02em;
    min-height: 64px;
    padding: 0 24px;
    text-decoration: none;
    transition: transform .18s ease, background .18s ease;
  }

  .bb-contact-manuscript svg {
    height: 24px;
    width: 24px;
  }

  .bb-contact-manuscript:hover {
    background: var(--bb-contact-accent);
    transform: translateY(-2px);
  }

  .bb-contact-form-panel {
    padding: clamp(24px, 3.4vw, 38px);
  }

  .bb-contact-form {
    display: grid;
    gap: 14px;
  }

  .bb-contact-form__row {
    display: grid;
    gap: 7px;
  }

  .bb-contact-form__row label {
    color: rgba(16, 33, 58, .72);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .bb-contact-form input,
  .bb-contact-form textarea {
    background: #fff;
    border: 1px solid rgba(16, 33, 58, .18);
    border-radius: 0;
    color: #10213a;
    font: inherit;
    min-height: 48px;
    padding: 13px 14px;
    width: 100%;
  }

  .bb-contact-form textarea {
    min-height: 118px;
    resize: vertical;
  }

  .bb-contact-form input:focus,
  .bb-contact-form textarea:focus {
    border-color: var(--bb-contact-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--bb-contact-accent) 16%, transparent);
    outline: none;
  }

  .bb-contact-form__submit {
    appearance: none;
    background: var(--bb-contact-accent);
    border: 1px solid var(--bb-contact-accent);
    border-radius: 0;
    color: #fff;
    cursor: pointer;
    font-weight: 900;
    min-height: 50px;
    padding: 0 24px;
    transition: background .18s ease, color .18s ease, transform .18s ease;
    width: fit-content;
  }

  .bb-contact-form__submit:hover {
    background: #10213a;
    border-color: #10213a;
    transform: translateY(-1px);
  }

  .bb-contact-form__success,
  .bb-contact-form__error {
    border: 1px solid currentColor;
    font-size: 14px;
    line-height: 1.5;
    padding: 12px 14px;
  }

  .bb-contact-form__success {
    color: #16784a;
    background: #effaf4;
  }

  .bb-contact-form__error {
    color: #b6191a;
    background: #fff4f4;
  }

  .bb-contact-map-card {
    display: grid;
    grid-template-columns: minmax(260px, 360px) minmax(0, 1fr);
    overflow: hidden;
  }

  .bb-contact-map-card__copy {
    align-self: center;
    padding: clamp(24px, 3.4vw, 38px);
  }

  .bb-contact-map {
    min-height: 360px;
  }

  .bb-contact-map iframe {
    border: 0;
    display: block;
    height: 100%;
    min-height: 360px;
    width: 100%;
  }

  @media (max-width: 899px) {
    .bb-contact-hero,
    .bb-contact-grid,
    .bb-contact-map-card {
      grid-template-columns: 1fr;
    }

    .bb-contact-card--address {
      min-height: 140px;
    }
  }

  @media (max-width: 640px) {
    .bb-contact-page {
      padding-top: 28px;
    }

    .bb-contact-mini-grid {
      grid-template-columns: 1fr;
    }

    .bb-contact-card,
    .bb-contact-form-panel,
    .bb-contact-map-card__copy {
      padding: 22px;
    }

    .bb-contact-form__submit {
      width: 100%;
    }
  }
{% endstylesheet %}

