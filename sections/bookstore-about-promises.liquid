<section class="bb-about-promises color-{{ section.settings.color_scheme }}" style="--bb-about-bg: {{ section.settings.background_color }}; --bb-about-card: {{ section.settings.card_color }}; --bb-about-accent: {{ section.settings.accent_color }}; --bb-about-max: {{ section.settings.max_width }}px; --bb-about-side: {{ section.settings.side_padding }}px; --bb-about-top: {{ section.settings.padding_top }}px; --bb-about-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="bb-about-inner">
    <div class="bb-about-promises__head">
      <p class="bb-about-kicker">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="bb-about-promises__grid">
      {% for block in section.blocks %}
        <div class="bb-about-promise-card" {{ block.shopify_attributes }}>
          <span>{{ forloop.index | prepend: '0' }}</span>
          <h3>{{ block.settings.heading }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .bb-about-promises {
    background: var(--bb-about-bg);
    padding: var(--bb-about-top) 0 var(--bb-about-bottom);
  }

  .bb-about-inner {
    margin: 0 auto;
    max-width: var(--bb-about-max);
    padding-left: var(--bb-about-side);
    padding-right: var(--bb-about-side);
    width: 100%;
  }

  .bb-about-kicker {
    color: var(--bb-about-accent);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .14em;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .bb-about-promises__head {
    max-width: 720px;
    margin-bottom: clamp(18px, 3vw, 30px);
  }

  .bb-about-promises__head h2 {
    color: #10213a;
    font-family: var(--font-heading--family, serif);
    font-size: clamp(28px, 4vw, 46px);
    line-height: 1.05;
    margin: 0;
  }

  .bb-about-promises__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .bb-about-promise-card {
    background: var(--bb-about-card);
    border: 1px solid rgba(16, 33, 58, .1);
    box-shadow: 0 14px 34px rgba(16, 33, 58, .06);
    min-height: 220px;
    padding: 24px;
  }

  .bb-about-promise-card span {
    color: var(--bb-about-accent);
    display: block;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .12em;
    margin-bottom: 34px;
  }

  .bb-about-promise-card h3 {
    color: #10213a;
    font-size: 18px;
    line-height: 1.2;
    margin: 0 0 10px;
  }

  .bb-about-promise-card p {
    color: rgba(16, 33, 58, .7);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 989px) {
    .bb-about-promises__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .bb-about-inner {
      padding-left: min(var(--bb-about-side), 20px);
      padding-right: min(var(--bb-about-side), 20px);
    }

    .bb-about-promises__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About promises",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f2f6ff" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#b6191a" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What we offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A bookstore experience built around trust and discovery" },
    { "type": "range", "id": "max_width", "label": "Content max width", "min": 900, "max": 1600, "step": 20, "unit": "px", "default": 1240 },
    { "type": "range", "id": "side_padding", "label": "Left/right padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 44 }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Curated catalogue" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A wide-ranging collection spanning multiple publishers, genres, and reader needs." }
      ]
    }
  ],
  "presets": [
    {
      "name": "About promises",
      "blocks": [
        { "type": "promise", "settings": { "heading": "Curated catalogue", "text": "A wide-ranging collection spanning multiple publishers, genres, and reader needs." } },
        { "type": "promise", "settings": { "heading": "Original books", "text": "Titles sourced through authorised channels, never pirated or counterfeit copies." } },
        { "type": "promise", "settings": { "heading": "Bulk support", "text": "Support for schools, libraries, colleges, institutions, and large reader communities." } },
        { "type": "promise", "settings": { "heading": "Secure ordering", "text": "A simple shopping flow with secure checkout and reliable delivery support." } }
      ]
    }
  ]
}
{% endschema %}
