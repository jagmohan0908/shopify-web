{%- liquid
  assign filter_style = filter_style | default: 'vertical'
  assign current_author = request.params['author'] | default: request.params['filter.p.m.custom.author'] | strip
  assign current_vendor_filter = request.params['filter.p.vendor'] | strip
  assign current_publisher = current_vendor_filter
  assign is_author_context = false
  assign is_publisher_context = false
  assign author_filter = blank
  assign publisher_filter = blank

  if template.name == 'search' and template.suffix == 'author'
    assign is_author_context = true
  endif

  if template.name == 'collection'
    assign collection_url_check = collection.url | default: ''
    if collection.handle == 'vendors' or collection_url_check contains '/collections/vendors'
      assign is_publisher_context = true
      assign current_publisher = collection.current_vendor | default: request.params['q'] | default: collection.title | strip
    endif
  endif

  if filters != blank
    for filter in filters
      assign filter_label = filter.label | downcase
      assign is_author_filter = false
      assign is_publisher_filter = false
      if filter.param_name contains 'author' or filter_label contains 'author'
        assign is_author_filter = true
      endif
      if filter.param_name contains 'vendor' or filter_label contains 'publisher'
        assign is_publisher_filter = true
      endif

      if author_filter == blank and is_author_filter
        assign author_filter = filter
        if current_author == blank and filter.active_values.size > 0
          assign current_author = filter.active_values.first.value | default: filter.active_values.first.label | strip
        endif
      elsif publisher_filter == blank and is_publisher_filter
        assign publisher_filter = filter
        if current_publisher == blank and filter.active_values.size > 0
          assign current_publisher = filter.active_values.first.value | default: filter.active_values.first.label | strip
        endif
      endif
    endfor
  endif

  if author_filter == blank
    for filter in collections.all.filters
      assign filter_label = filter.label | downcase
      if filter.param_name contains 'author' or filter_label contains 'author'
        assign author_filter = filter
        break
      endif
    endfor
  endif

  if publisher_filter == blank
    for filter in collections.all.filters
      assign filter_label = filter.label | downcase
      if filter.param_name contains 'vendor' or filter_label contains 'publisher'
        assign publisher_filter = filter
        break
      endif
    endfor
  endif

  assign current_author_key = current_author | handleize
  assign current_publisher_key = current_publisher | handleize
  assign author_param_name = 'filter.p.m.custom.author'
  if author_filter != blank
    assign author_param_name = author_filter.param_name
  endif
-%}

{% capture author_panel %}
  {% if author_filter != blank and author_filter.values.size > 0 %}
    <details
      class="facets__panel bookstore-entity-facet bookstore-entity-facet--author-search"
      {% if filter_style == 'horizontal' %}data-auto-close-details="desktop"{% endif %}
      {% if filter_style == 'vertical' or in_drawer %}open{% endif %}
    >
      <summary class="facets__summary">
        <span class="facets__label">Author</span>
        <div class="facets__status-wrapper">
          <span class="facets__status h6 desktop:hidden">{% if current_author != blank %}{{ current_author }}{% else %}Find author{% endif %}</span>
          <span class="svg-wrapper icon-caret icon-animated">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        </div>
      </summary>

      <div class="facets__inputs-wrapper bookstore-entity-facet__inputs">
        <div class="bookstore-entity-author-search" role="search" data-author-sidebar-search data-entity-filter-search>
          <input type="hidden" name="view" value="author">
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="q" value="*">
          <input type="hidden" name="{{ author_param_name }}" value="{{ current_author | escape }}" data-author-sidebar-filter-value>
          <label class="visually-hidden" for="BookstoreAuthorSidebarSearch-{{ section_id | default: 'main' }}{% if in_drawer %}-drawer{% endif %}">Search author</label>
          <input
            id="BookstoreAuthorSidebarSearch-{{ section_id | default: 'main' }}{% if in_drawer %}-drawer{% endif %}"
            type="search"
            data-author-search-input
            data-entity-filter-search-input
            placeholder="Search author"
            value="{{ current_author | escape }}"
            autocomplete="off"
          >
          <button type="button" data-author-search-submit aria-label="Search author">Search</button>
        </div>

        <ul class="facets__inputs-list bookstore-entity-facet__list list-unstyled" role="list" data-entity-filter-list>
          {% assign rendered_author_count = 0 %}
          {% for author_value in author_filter.values limit: 250 %}
            {% liquid
              assign author_name = author_value.label | default: author_value.value | strip
              assign author_key = author_name | handleize
              assign author_value_raw = author_value.value | default: author_name
              assign is_current_author = false
              if author_key == current_author_key
                assign is_current_author = true
              endif
            %}
            {% if author_name != blank and author_value.count > 0 %}
              {% assign rendered_author_count = rendered_author_count | plus: 1 %}
              <li class="facets__inputs-list-item" {% if rendered_author_count > 12 %}hidden data-entity-extra-item{% endif %}>
                <label class="bookstore-author-filter-row">
                  <input
                    type="checkbox"
                    name="{{ author_param_name }}"
                    value="{{ author_value_raw | escape }}"
                    {% if is_current_author %}checked{% endif %}
                    onchange="this.form?.requestSubmit ? this.form.requestSubmit() : this.form.submit()"
                  >
                  <span class="bookstore-author-filter-row__box" aria-hidden="true"></span>
                  <span class="bookstore-author-filter-row__label">{{ author_name }}</span>
                </label>
              </li>
            {% endif %}
          {% endfor %}
        </ul>

        {% if rendered_author_count > 12 %}
          <button type="button" class="bookstore-entity-show-more" data-entity-show-more>+ Show more</button>
        {% endif %}
      </div>
    </details>
  {% endif %}
{% endcapture %}

{% capture publisher_panel %}
  {% if publisher_filter != blank or collections.all.all_vendors.size > 0 %}
    <details
      class="facets__panel bookstore-collection-facet bookstore-entity-facet bookstore-entity-facet--publisher-search"
      {% if filter_style == 'horizontal' %}data-auto-close-details="desktop"{% endif %}
      {% if filter_style == 'vertical' or in_drawer %}open{% endif %}
    >
      <summary class="facets__summary">
        <span class="facets__label">Publisher</span>
        <div class="facets__status-wrapper">
          <span class="facets__status h6 desktop:hidden">{% if current_publisher != blank %}{{ current_publisher }}{% else %}Find publisher{% endif %}</span>
          <span class="svg-wrapper icon-caret icon-animated">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        </div>
      </summary>

      <div class="facets__inputs-wrapper bookstore-collection-facet__inputs bookstore-entity-facet__inputs">
        <div class="bookstore-entity-author-search bookstore-entity-publisher-search" role="search" data-entity-filter-search>
          <label class="visually-hidden" for="BookstorePublisherSidebarSearch-{{ section_id | default: 'main' }}{% if in_drawer %}-drawer{% endif %}">Search publisher</label>
          <input
            id="BookstorePublisherSidebarSearch-{{ section_id | default: 'main' }}{% if in_drawer %}-drawer{% endif %}"
            type="search"
            data-entity-filter-search-input
            placeholder="Search publisher"
            value="{{ current_publisher | escape }}"
            autocomplete="off"
          >
          <button type="button" data-entity-filter-search-button aria-label="Search publisher">Search</button>
        </div>

        <ul class="facets__inputs-list bookstore-collection-facet__list list-unstyled" role="list" data-entity-filter-list>
          {% assign rendered_publisher_count = 0 %}
          {% if publisher_filter != blank and publisher_filter.values.size > 0 %}
            {% for publisher_value in publisher_filter.values limit: 250 %}
              {% liquid
                assign publisher_name = publisher_value.label | default: publisher_value.value | strip
                assign publisher_value_raw = publisher_value.value | default: publisher_name
                assign publisher_key = publisher_name | handleize
                assign is_current_publisher = false
                if publisher_key == current_publisher_key
                  assign is_current_publisher = true
                endif
              %}
              {% if publisher_name != blank and publisher_value.count > 0 %}
                {% assign rendered_publisher_count = rendered_publisher_count | plus: 1 %}
                <li class="facets__inputs-list-item" {% if rendered_publisher_count > 12 %}hidden data-entity-extra-item{% endif %}>
                  <label class="bookstore-collection-facet__link{% if is_current_publisher %} is-active{% endif %}">
                    <input
                      type="checkbox"
                      name="filter.p.vendor"
                      value="{{ publisher_value_raw | escape }}"
                      {% if is_current_publisher %}checked{% endif %}
                      onchange="this.form?.requestSubmit ? this.form.requestSubmit() : this.form.submit()"
                    >
                    <span aria-hidden="true"></span>
                    <span>{{ publisher_name }}</span>
                  </label>
                </li>
              {% endif %}
            {% endfor %}
          {% else %}
            {% for vendor in collections.all.all_vendors limit: 250 %}
              {% liquid
                assign publisher_name = vendor | strip
                assign publisher_key = publisher_name | handleize
                assign is_current_publisher = false
                if publisher_key == current_publisher_key
                  assign is_current_publisher = true
                endif
              %}
              {% if publisher_name != blank %}
                {% assign rendered_publisher_count = rendered_publisher_count | plus: 1 %}
                <li class="facets__inputs-list-item" {% if rendered_publisher_count > 12 %}hidden data-entity-extra-item{% endif %}>
                  <label class="bookstore-collection-facet__link{% if is_current_publisher %} is-active{% endif %}">
                    <input
                      type="checkbox"
                      name="filter.p.vendor"
                      value="{{ publisher_name | escape }}"
                      {% if is_current_publisher %}checked{% endif %}
                      onchange="this.form?.requestSubmit ? this.form.requestSubmit() : this.form.submit()"
                    >
                    <span aria-hidden="true"></span>
                    <span>{{ publisher_name }}</span>
                  </label>
                </li>
              {% endif %}
            {% endfor %}
          {% endif %}
        </ul>

        {% if rendered_publisher_count > 12 %}
          <button type="button" class="bookstore-entity-show-more" data-entity-show-more>+ Show more</button>
        {% endif %}
      </div>
    </details>
  {% endif %}
{% endcapture %}

{% if is_author_context %}
  {{ author_panel }}
  {{ publisher_panel }}
{% elsif is_publisher_context %}
  {{ publisher_panel }}
  {{ author_panel }}
{% else %}
  {{ publisher_panel }}
  {{ author_panel }}
{% endif %}
